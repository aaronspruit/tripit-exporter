# The private TripIt calendar feed URL. See the README for how to copy it
# from the TripIt website. Treat it as a credential.
TRIPIT_FEED_URL=https://www.tripit.com/feed/ical/private/your-key/tripit.ics

# The JSON refresh. See "Part 2: the full history" in the README. It is off
# by default. TRIPIT_SESSION is the value of the TripIt cookie it_session_id.
# Treat it as a credential.
# TRIPIT_JSON_REFRESH=true
# TRIPIT_JSON_REFRESH_LOOKBACK_DAYS=7
# TRIPIT_SESSION=

# The AirTrail sync. See "The AirTrail sync" in the README. It is off by
# default. Make the API key in AirTrail under Settings, and treat it as a
# credential.
# TRIPIT_AIRTRAIL_SYNC=true
# TRIPIT_AIRTRAIL_URL=https://airtrail.example.com
# TRIPIT_AIRTRAIL_API_KEY=
